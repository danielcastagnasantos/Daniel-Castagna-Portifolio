# ============================================================
# Caixa Central — variáveis de ambiente (copie para .env.local)
# NUNCA faça commit de .env.local. Só NEXT_PUBLIC_* vai ao navegador.
# ============================================================

# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...) ou a anon legada. Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave SECRETA (service_role / sb_secret_...). SOMENTE no servidor (Vercel: Environment Variables).
# Usada para: cadastro inicial, criar/bloquear logins e rotina agendada. Nunca com prefixo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ----------------------------------------------------------
# URL pública (usada em links de e-mail). Ex.: https://caixa.suaempresa.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Código exigido no cadastro inicial (/setup). OBRIGATÓRIO em produção.
# Gere com: openssl rand -hex 16
SETUP_TOKEN=

# --- Rotina agendada de alertas (Vercel Cron) ------------------------------
# Segredo que autoriza GET /api/cron/notifications. Gere com: openssl rand -hex 32
CRON_SECRET=

# --- E-mail de alertas (opcional) ------------------------------------------
# none (padrão: só alertas dentro do sistema) | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="Caixa Central <alertas@seu-dominio.com.br>"

# --- Somente para testes locais (não use em produção) ----------------------
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
