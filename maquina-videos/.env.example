# ─────────────────────────────────────────────────────────────────────────────
# Máquina de Vídeos — variáveis de ambiente
# Copie este arquivo para ".env" (na pasta maquina-videos) e preencha o que for usar.
# NUNCA coloque chaves no código nem suba o .env para o Git (já está no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor local ───────────────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 = só este computador acessa. Se mudar, defina API_TOKEN (obrigatório).
HOST=127.0.0.1
# Token opcional para a API (use com n8n/automação ou se HOST != 127.0.0.1).
# Enviado como "Authorization: Bearer <token>".
API_TOKEN=

# ── Modo de teste ────────────────────────────────────────────────────────────
# true  = NENHUMA chamada paga (roteiro, voz e imagens são gerados localmente).
# false = usa as APIs reais configuradas abaixo (gera custo).
# É só o padrão de novos projetos; cada projeto escolhe na criação.
DEFAULT_TEST_MODE=true

# ── Claude (Anthropic) — roteiro, ideias, revisão ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# default = pede ao servidor da Anthropic um modelo de reserva caso haja recusa de segurança.
# off = desliga.
ANTHROPIC_FALLBACKS=default

# ── ElevenLabs — narração ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# ID da voz (painel ElevenLabs > Voices > "Copy voice ID"). Cada marca pode ter a sua
# em config/brands/<marca>.json (campo voice.voiceId); este é o padrão.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Runway — geração de imagens/vídeos (opcional, fase 2) ────────────────────
RUNWAYML_API_SECRET=
# Modelos usados (troque se a Runway renomear/lançar novos):
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_MODEL=gen4_turbo

# ── Telegram — avisos e aprovação (opcional, fase 2) ─────────────────────────
TELEGRAM_BOT_TOKEN=
# Seu chat_id (mande /start ao bot e use o comando `npm run doctor` para descobrir).
TELEGRAM_CHAT_ID=

# ── n8n / webhooks de saída (opcional, fase 2) ───────────────────────────────
# Se definido, o servidor faz POST nesta URL a cada evento importante
# (roteiro pronto, vídeo pronto, falha...). Use o nó "Webhook" do n8n.
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── FFmpeg / navegador ───────────────────────────────────────────────────────
# Se ffmpeg/ffprobe não estiverem no PATH, aponte para os executáveis:
FFMPEG_PATH=
FFPROBE_PATH=
# Se quiser usar um Chrome/Chromium específico no Remotion (opcional):
BROWSER_EXECUTABLE=

# ── Render ───────────────────────────────────────────────────────────────────
# Quantas abas paralelas o Remotion usa (vazio = automático).
RENDER_CONCURRENCY=
# CRF do H.264 (menor = mais qualidade/maior arquivo). 18 = ótima, 23 = padrão.
RENDER_CRF=18

# ── Pasta de dados (projetos, áudios, renders) ───────────────────────────────
DATA_DIR=./data
